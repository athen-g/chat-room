# LLM Provider Configuration
# Set OPENAI_API_KEY or GEMINI_API_KEY to use a real LLM model.
# If left empty, the server will operate in deterministic Mock/Fallback mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Alternative Gemini API config
GEMINI_API_KEY=

# Server Config
PORT=8000
HOST=0.0.0.0
